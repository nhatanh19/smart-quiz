# Application Settings
PROJECT_NAME="Smart Quiz API"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/smart_quiz"

# Authentication & JWT Security
SECRET_KEY="change_this_to_a_super_secret_jwt_key_in_production_min_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true when serving over HTTPS in production
COOKIE_SECURE=false

# Seed Script Default Password
SEED_DEFAULT_PASSWORD="SmartQuiz@123"

# ==============================================================================
# AI LLM Provider Configuration
# Project direction: ALWAYS use the OpenAI-compatible API (openai lib + custom
# base_url) so we can swap hosts (OpenAI / Gemini / Ollama / vLLM) without code change.
# ==============================================================================

# --- Option A: OpenAI (default) ---
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL_NAME="gpt-4o-mini"

# --- Option B: Google Gemini via its OpenAI-compatible endpoint (recommended here) ---
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY="your-gemini-api-key"
LLM_MODEL_NAME="gemini-2.0-flash"
# Backup model used automatically when the primary model is slow/unavailable
# (model-level failover). Leave empty to disable.
LLM_FALLBACK_MODEL_NAME="gemini-2.0-flash-lite"

LLM_TIMEOUT_SECONDS=30.0

# AI Tutor latency budget (Issue #16 DoD < 3s):
#   AI_TUTOR_TIMEOUT_SECONDS       = overall hard ceiling for the whole /explain call
#   AI_TUTOR_MODEL_TIMEOUT_SECONDS = per-model slice before failing over to the backup model
# Order of degradation: primary model -> backup model -> rule-based pedagogical fallback.
AI_TUTOR_TIMEOUT_SECONDS=2.8
AI_TUTOR_MODEL_TIMEOUT_SECONDS=1.8
# Cap tutor output length (avoid truncation -> invalid JSON; bound generation time)
AI_TUTOR_MAX_TOKENS=700
